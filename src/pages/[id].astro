---
import katexCss from 'katex/dist/katex.min.css?url';

import Base from '../layouts/Base.astro';
import PostHeader from '../components/PostHeader.astro';
import PostNav from '../components/PostNav.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PostEnhancer from '../islands/PostEnhancer';
import { allPosts, summaryOf } from '../lib/posts';
import { renderMarkdown } from '../lib/markdown';
import { describePost } from '../lib/describePost';
import { readingTime } from '../lib/readingTime';
import { relatedPosts } from '../lib/related';
import { resolveImageUrl } from '../lib/imageUtils';
import { postCardUrl } from '../lib/card';
import { AUTHOR, AUTHOR_URL, LICENSE_URL, SITE_NAME, SITE_URL } from '../lib/site';

export async function getStaticPaths() {
  const posts = await allPosts();
  const summaries = posts.map(summaryOf);
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      // Neighbours in publication order, for the links at the end.
      newer: index > 0 ? summaries[index - 1] : undefined,
      older: index < posts.length - 1 ? summaries[index + 1] : undefined,
      related: relatedPosts(post, summaries),
    },
  }));
}

const { post, newer, older, related } = Astro.props;
const rendered = renderMarkdown(post.content);
const summary = summaryOf(post);
const minutes = readingTime(post.content);
const description = describePost(summary);
// A card drawn for the post at build time, unless the post brings its own.
const image = post.image ? resolveImageUrl(post.image, SITE_URL) : await postCardUrl(post);
const url = `${SITE_URL}/${post.id}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    license: LICENSE_URL,
    description,
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    keywords: post.tags?.join(', '),
    author: { '@type': 'Person', name: AUTHOR, url: AUTHOR_URL },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      url: SITE_URL,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/og/default.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: post.title, item: url },
    ],
  },
];
---

<Base
  title={`${post.title} · ${SITE_NAME}`}
  description={description}
  image={image}
  type="article"
  publishedAt={post.publishedAt}
>
  <Fragment slot="head">
    {rendered.hasMath && <link rel="stylesheet" href={katexCss} />}
    {structuredData.map(data => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </Fragment>
  <article class="article">
    <PostHeader post={summary} minutes={minutes} headings={rendered.headings} />
    <div class="prose" set:html={rendered.html} />
    <PostNav newer={newer} older={older} />
    <RelatedPosts posts={related} />
  </article>
  <PostEnhancer client:idle mermaid={rendered.hasMermaid} />
</Base>
