---
import type { IHeading, IPostSummary } from '../lib/types';
import { isoDate, longDate } from '../lib/dates';
import { tagHref } from '../lib/tags';

interface Props {
  post: IPostSummary;
  minutes: number;
  headings: IHeading[];
}

// Show a table of contents only when there is enough to navigate.
const TOC_MIN_HEADINGS = 3;

// The head of a post: title, then one line with the date, the reading time
// and the tags, the snippet, and a folded list of the article's sections
// when there are a few.
const { post, minutes, headings } = Astro.props;
---

<header class="intro">
  <h1 class="title pageTitle">
    {post.title}
    {post.leetcode_number ? <span class="titleNumber">{` #${post.leetcode_number}`}</span> : null}
  </h1>
  <p class="meta">
    <time datetime={isoDate(post.publishedAt)}>{longDate(post.publishedAt)}</time>
    <span class="metaDot" aria-hidden="true">
      ·
    </span>
    <span>{minutes} min read</span>
    {post.tags && post.tags.length > 0 && (
      <>
        <span class="metaDot" aria-hidden="true">
          ·
        </span>
        <span class="srOnly">Tagged</span>
        {post.tags.map((tag, index) => (
          <>
            {index > 0 && (
              <span class="metaDot" aria-hidden="true">
                ·
              </span>
            )}
            <a class="tag" href={tagHref(tag)}>
              <span aria-hidden="true">#</span>
              {tag}
            </a>
          </>
        ))}
      </>
    )}
  </p>

  {post.snippet && <p class="standfirst">{post.snippet}</p>}

  {headings.length >= TOC_MIN_HEADINGS && (
    <details class="toc">
      <summary class="tocLabel">Contents</summary>
      <ol class="tocList">
        {headings.map(heading => (
          <li>
            <a class="tocLink" href={`#${heading.id}`}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  )}
</header>
