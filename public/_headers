# Security headers for every response. The policy names the only third
# party the site uses, the analytics host; mermaid and the KaTeX fonts are
# bundled. The build replaces 'unsafe-inline' below with a hash of each inline
# script the pages carry (scripts/csp-hashes.mjs) and adds a Link header that
# preloads the stylesheet and the fonts, which the edge replays as 103 Early
# Hints (scripts/early-hints.mjs).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.arcbjorn.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://analytics.arcbjorn.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Hashed build output and the fonts never change under one name. The
# preloads are for pages, not for the files they name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  ! Link
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  ! Link
/og/*
  ! Link
/images/*
  ! Link
